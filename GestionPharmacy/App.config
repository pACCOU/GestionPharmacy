<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Base SQL Server LocalDB (fichier MaPharmacie.mdf créé par database/MaPharmacie.sql).
      |DataDirectory| = dossier de l'exécutable : copiez le .mdf à côté de GestionPharmacy.exe,
      ou remplacez par une instance SQL Server classique :
        Server=localhost;Database=MaPharmacie;Integrated Security=True
    -->
    <add name="MaPharmacie"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\MaPharmacie.mdf;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
